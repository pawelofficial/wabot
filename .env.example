# Copy to .env and fill in. See README.md for where each value comes from.
# The messenger: telegram (default) or whatsapp. Only its settings below need values.
# CHANNEL=telegram
# From @BotFather on Telegram (/newbot):
TELEGRAM_BOT_TOKEN=
# Your own number, digits only (e.g. 48123456789): scripts/add_trainee.py registers it.
WHATSAPP_TEST_RECIPIENT=
# WhatsApp (CHANNEL=whatsapp):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_ID=   # optional; scripts/set_webhook.py looks it up via the token
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# Messages the bot starts come from wabot/utils.py instead of the LLM:
# HARDCODED_FIRST_MESSAGE=True
# History the LLM gets: marked (all recent, new report marked) or new_only (just the new report):
# HISTORY_MODE=marked
# One weight and one training per day, a newer report overwrites it (default False: every
# report is kept as its own row; the newest row of a day is the current value):
# DAILY_UPDATES_ONLY=False
# DATABASE_URL=sqlite:///wabot.db
